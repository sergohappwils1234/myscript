-- 1. Auto Summon & Sell Loop
task.spawn(function()
    while true do
        if S.AutoSummon then
            local banner = availableBanners[S.SummonBannerIdx] or "Standard"
            local amount = (S.SummonAmountIdx == 2) and 10 or 1

            -- Fire Summon
            local success, res = pcall(function()
                return SummonRF:InvokeServer(amount, banner)
            end)

            if success and type(res) == "table" then
                -- Fallback Manual Delete: We grab the exact UUIDs directly from the summon result
                -- This guarantees it deletes the exact unit rolled, even if the native auto-delete fails.
                for _, item in pairs(res) do
                    if type(item) == "table" and item.uuid then
                        local tData = TowersData.getTowerData(item.tower)
                        if tData then
                            local rarity = tData.Rarity
                            local isShiny = item.shiny
                            
                            local shouldDelete = false
                            if isShiny and S.DeleteShiny[rarity] then shouldDelete = true end
                            if not isShiny and S.DeleteNormal[rarity] then shouldDelete = true end
                            
                            if shouldDelete then
                                task.spawn(function()
                                    pcall(function() DeleteUnitRF:InvokeServer(item.uuid) end)
                                    pcall(function() DeleteUnitRF:InvokeServer({item.uuid}) end)
                                end)
                            end
                        end
                    end
                end
            end
            task.wait(S.SummonDelay)
        else
            task.wait(0.5)
        end
    end
end)

-- 2. Smart Auto Enchant Loop
task.spawn(function()
    while true do
        if S.AutoEnchant and activeEnchantUUID then
            local tData = Constants.currentPlrData.Items.Towers[activeEnchantUUID]
            
            if not tData then
                S.AutoEnchant = false
                activeEnchantUUID = nil
                print("[Macro] Tower lost. Auto Enchant stopped.")
                createUI()
            else
                local currentEnchant = (tData.Mutations and tData.Mutations.Enchant) or "None"
                
                if S.TargetEnchants[currentEnchant] then
                    -- Hit target! Stop immediately.
                    S.AutoEnchant = false
                    activeEnchantUUID = nil
                    print("[Macro] Hit Target Enchant: " .. currentEnchant .. "! Stopping.")
                    createUI()
                else
                    -- Fire the remote. InvokeServer yields until the server completes the enchant.
                    local success, result = pcall(function() 
                        return EnchantRF:InvokeServer(activeEnchantUUID) 
                    end)
                    
                    if success then
                        -- The server has finished processing. Check the new enchant.
                        local newData = Constants.currentPlrData.Items.Towers[activeEnchantUUID]
                        if newData then
                            local newEnch = (newData.Mutations and newData.Mutations.Enchant) or "None"
                            if S.TargetEnchants[newEnch] then
                                S.AutoEnchant = false
                                activeEnchantUUID = nil
                                print("[Macro] Hit Target Enchant: " .. newEnch .. "! Stopping.")
                                createUI()
                            end
                        end
                    end
                end
            end
            task.wait(S.EnchantDelay)
        else
            task.wait(0.1)
        end
    end
end)

