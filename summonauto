local SETTINGS_FILE = "NoobTD_LobbySettings_" .. LP.Name .. ".json"

local S = {
    SummonBannerIdx = 1,
    SummonAmountIdx = 1, -- 1 = 1x, 2 = 10x
    SummonDelay = 0.5,
    AutoSummon = false,
    
    DeleteNormal = {Common=false, Rare=false, Epic=false, Legendary=false, Mythic=false, Secret=false, Exclusive=false},
    DeleteShiny = {Common=false, Rare=false, Epic=false, Legendary=false, Mythic=false, Secret=false, Exclusive=false},
    
    TargetEnchants = {},
    EnchantDelay = 0.3,
    AutoEnchant = false,
    
    BuyCrateDelay = 0.5,
    AutoBuyCrate = false,
    
    SpinCrateDelay = 0.5,
    AutoSpinCrate = false
}

local function saveSettings()
    pcall(function() writefile(SETTINGS_FILE, HttpService:JSONEncode(S)) end)
end

local function loadSettings()
    pcall(function()
        if isfile(SETTINGS_FILE) then
            local data = HttpService:JSONDecode(readfile(SETTINGS_FILE))
            for k, v in pairs(data) do 
                if type(v) == "table" and type(S[k]) == "table" then
                    for subK, subV in pairs(v) do S[k][subK] = subV end
                else
                    S[k] = v 
                end
            end
        end
    end)
end
loadSettings()

