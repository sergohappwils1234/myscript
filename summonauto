-- NATIVE AUTO DELETE SYNC
-----------------------------------
local function syncNativeAutoDelete(rarity, isShiny, state)
    if AutoDeleteRF then
        task.spawn(function()
            pcall(function() AutoDeleteRF:InvokeServer(rarity, isShiny, state) end)
            pcall(function() AutoDeleteRF:InvokeServer(rarity, state) end)
        end)
    end
end

-----------------------------------
-- INVENTORY GROUPING
-----------------------------------
local inventorySorted = {}
local activeEnchantUUID = nil
local activeEnchantDisplay = "None"

local function getInventoryGroups()
    local groups = {}
    local inv = Constants.currentPlrData.Items.Towers
    local eq = Constants.currentPlrData.Equipped.Towers
    local eqMap = {}
    for _, u in pairs(eq) do eqMap[u] = true end
    
    for uuid, tData in pairs(inv) do
        if not eqMap[uuid] and not tData.Locked then
            local ench = (tData.Mutations and tData.Mutations.Enchant) or "None"
            local shiny = (tData.Mutations and tData.Mutations.Shiny) and "Yes" or "No"
            local name = tData.Tower
            
            local key = name .. "|" .. ench .. "|" .. shiny
            local display = string.format("%s | Ench: %s | Shiny: %s", name, ench, shiny)
            
            if not groups[key] then
                groups[key] = {display = display, count = 0, uuids = {}}
            end
            groups[key].count += 1
            table.insert(groups[key].uuids, uuid)
        end
    end
    
    local sorted = {}
    for k, v in pairs(groups) do
        table.insert(sorted, {key = k, display = string.format("[x%d] %s", v.count, v.display), uuids = v.uuids, rawDisplay = v.display})
    end
    table.sort(sorted, function(a,b) return a.display < b.display end)
    return sorted
end

