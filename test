            if gr then sLbl.Text = "🎮 W" .. wv .. " $" .. gCoins(); sLbl.TextColor3 = C.Ok
            elseif isGameOver then sLbl.Text = "🏁 Game Over $" .. gCoins(); sLbl.TextColor3 = C.Org
            else sLbl.Text = "⚪ Lobby $" .. gCoins(); sLbl.TextColor3 = C.Dim end
        end

