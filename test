local function getDynamicTowerID(targetTowerName)
    local data = GameConstants.currentPlrData
    if data and data.Equipped and data.Items then
        for slot, uuid in pairs(data.Equipped.Towers) do
            if uuid and data.Items.Towers[uuid] then
                if data.Items.Towers[uuid].Tower == targetTowerName then
                    return uuid
                end
            end
        end
    end
    return nil
end

