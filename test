                    S.readyFired = true
                    S.gamemodeLogged = false
                    addLog("🟢 Firing Ready Up", C.Cyn)
                    pcall(function() ReadyEvent:FireServer() end)
                end
                
                -- Continuously check and vote gamemode while in lobby to ensure it doesn't miss the UI
                if S.gamemode and S.gamemode ~= "" then
                    if tick() - (S.lastGamemodeAttempt or 0) > 2 then
                        S.lastGamemodeAttempt = tick()
                        if not S.gamemodeLogged then
                            addLog("🗳️ Voting Gamemode: " .. S.gamemode, C.Cyn)
                            S.gamemodeLogged = true
                        end
                        pcall(function() GamemodeEvent:FireServer(S.gamemode) end)
                    end
                end
            end

        -- PLAYING STATE
        elseif gr then
            S.readyFired = false
            S.gameEndHandled = false

            -- ROBUST SPEED CHECK: Smart Auto-Speed & Anti-Downgrade
            if S.autoSpeed then
                local currentSpeed = 1
                pcall(function() currentSpeed = math.floor(Values.Speed.Value) end)
                
                local target = S.targetSpeed or 3
                
                if currentSpeed ~= target then
                    local voteUI
                    pcall(function() voteUI = LP.PlayerGui.UI.Game:FindFirstChild("SpeedVote") end)
                    
                    if voteUI and voteUI.Visible then
                        local newSpeedText = ""
                        pcall(function() newSpeedText = voteUI.Container.Info.New.Text end)
                        local newSpeed = tonumber(string.match(newSpeedText, "%d+")) or 0
                        
                        if newSpeed == target or (newSpeed > currentSpeed and target > currentSpeed) or (newSpeed < currentSpeed and target < currentSpeed) then
                            if tick() - (S.lastVoteAttempt or 0) > 1.5 then
                                S.lastVoteAttempt = tick()
                                addLog("⚡ Voting YES for " .. newSpeed .. "x Speed", C.Cyn)
                                pcall(function() SpeedEventVote:FireServer() end)
                            end
                        else
                            -- Hide useless vote
                            pcall(function() voteUI.Visible = false end)
                        end
                    else
                        if tick() - (S.lastSpeedAttempt or 0) > 5 then
                            S.lastSpeedAttempt = tick()
                            addLog("⚡ Initiating Vote for " .. target .. "x Speed...", C.Cyn)
                            pcall(function() InitSpeedEvent:FireServer(target) end)
                        end
                    end
                end
            end

            -- AUTO USE ABILITIES (100% Dynamic)
            if S.autoAbility then
                if tick() - (S.lastAbilityAttempt or 0) > 1 then
                    S.lastAbilityAttempt = tick()
                    for tID, tName in pairs(myTowerNames) do
                        if towerAbilitiesCache[tName] then
                            for abName in pairs(towerAbilitiesCache[tName]) do
                                task.spawn(function()
                                    pcall(function() TowerAbility:InvokeServer(tID, abName) end)
                                end)
                            end
                        end
                    end
                end
            end

            if S.autoPlay and S.macro and not S.replaying and not S.macroPlayed then
                S.macroPlayed = true
                task.spawn(function()
                    task.wait(2)
                    if S.autoPlay and not S.replaying and _G.__TOWER_MACRO then
                        addLog("🤖 AUTO PLAY START", C.Cyn); doReplay(S.macro, sLbl)
                    end
                end)
            end

        -- GAME OVER STATE
        elseif isGameOver then
            S.readyFired = false
            S.macroPlayed = false

            if not S.gameEndHandled then
                S.gameEndHandled = true
                
                -- Send Discord Webhook
                sendWebhook()

                if S.autoReplay then
                    addLog("🔄 Auto Replay in 4s...", C.Cyn)
                    task.spawn(function()
                        task.wait(4)
                        if _G.__TOWER_MACRO then
                            pcall(function() ReplayEvent:FireServer() end)
                            addLog("🔄 Replay Fired", C.Ok)
                        end
                    end)
                end
            end
        end

