local function getPlaceablePart()
    local innerMap = MapFolder:FindFirstChild("Map")
    if innerMap then
        for _, child in ipairs(innerMap:GetChildren()) do
            if child:IsA("Model") or child:IsA("Folder") then
                local placeable = child:FindFirstChild("Placeable")
                if placeable then
                    local p = placeable:FindFirstChild("Part") or placeable:FindFirstChildWhichIsA("BasePart")
                    if p then return p end
                end
            end
        end
    end
    return nil
end

local function extractID(tbl)
    for k, v in pairs(tbl) do
        if type(v) == "string" and string.match(v, "^%x+%-%x+%-%x+%-%x+%-%x+$") then return v end
        if type(v) == "string" and string.match(v, "^%d+$") then return v end
        if type(v) == "number" then return tostring(v) end
        if type(v) == "table" then
            local res = extractID(v)
            if res then return res end
        end
    end
    return nil
end

