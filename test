-- ==================== REPLAY SYSTEM ====================
local function doReplay(data, sL)
    if not data or not data.actions or #data.actions == 0 then addLog("❌ No actions", C.Bad); return end
    S.replaying = true
    resetTowerTracking()
    addLog("▶ REPLAY START (" .. #data.actions .. ")", C.Cyn)
    
    for i, a in ipairs(data.actions) do
        if not canGo() or checkGameOver() then addLog("⏹ STOPPED at #" .. i, C.Org); break end

        if a.type == "place" then
            if sL then sL.Text = "📍 " .. a.towerName .. " (" .. i .. "/" .. #data.actions .. ")" end

            local placePart = getPlaceablePart()
            local actualID = getDynamicTowerID(a.towerName) or a.towerID
            local args = {[1] = {["towerID"] = actualID,["towerToPlace"] = a.towerName,["instance"] = placePart, ["position"] = Vector3.new(a.x, a.y, a.z)}}

            currentReplayPlacementOrder = a.placementOrder
            local preCount = myPlacedCount
            
            while canGo() and not checkGameOver() do
                local ok, res = pcall(function() return PlaceTower:InvokeServer(unpack(args)) end)
                
                if ok and type(res) == "table" then
                    local sID = extractID(res)
                    if sID then myPlacedTowers[a.placementOrder] = sID end
                    
                    local waited = 0
                    while myPlacedCount == preCount and waited < 3 do
                        task.wait(0.1)
                        waited = waited + 0.1
                    end
                    addLog("✅ PLACED #" .. a.placementOrder .. " " .. a.towerName, C.Ok)
                    break
                elseif ok and type(res) == "string" then
                    local err = string.upper(res)
                    if string.match(err, "ENOUGH") or string.match(err, "COIN") or string.match(err, "CASH") or string.match(err, "MONEY") then
                        task.wait(0.25)
                    else
                        addLog("❌ PLACE FAILED: " .. res, C.Bad)
                        failedPlacements[a.placementOrder] = true 
                        break
                    end
                else
                    task.wait(0.25)
                end
            end

        elseif a.type == "upgrade" then
            if failedPlacements[a.placementOrder] then
                addLog("⏭️ SKIP UPG: Tower #" .. a.placementOrder .. " missing", C.Dim)
                continue
            end

            local targetId = myPlacedTowers[a.placementOrder]
            
            local waitedId = 0
            while not targetId and waitedId < 5 and canGo() and not checkGameOver() do
                task.wait(0.25)
                waitedId = waitedId + 0.25
                targetId = myPlacedTowers[a.placementOrder]
            end
            
            if not targetId then
                addLog("❌ UPG FAILED: Tower ID missing", C.Bad)
                continue 
            end

            if sL then sL.Text = "⬆ Upgrade #" .. a.placementOrder .. " (" .. i .. "/" .. #data.actions .. ")" end
            local args = {[1] = targetId }
            
            while canGo() and not checkGameOver() do
                local ok, res1, res2 = pcall(function() return UpgradeTower:InvokeServer(unpack(args)) end)
                if ok then
                    local msg = tostring(res1 or "") .. tostring(res2 or "")
                    local err = string.upper(msg)
                    if res1 == true or err == "TRUE" or string.match(err, "SUCCESS") then
                        addLog("✅ UPGRADED #" .. a.placementOrder, C.Blu)
                        break
                    elseif string.match(err, "ENOUGH") or string.match(err, "COIN") or string.match(err, "CASH") or string.match(err, "MONEY") then
                        task.wait(0.25)
                    else
                        addLog("❌ UPG FAILED: " .. msg, C.Bad)
                        break
                    end
                else
                    task.wait(0.25)
                end
            end
        end
    end

    if S.autoMax and canGo() and not checkGameOver() then
        addLog("🌟 AUTO-MAXING ALL TOWERS...", C.Org)
        if sL then sL.Text = "🌟 Auto-Maxing..." end
        local maxedTowers = {}
        
        while canGo() and not checkGameOver() do
            local upgradedAny = false
            for order, tID in pairs(myPlacedTowers) do
                if not canGo() or checkGameOver() then break end
                if maxedTowers[tID] then continue end
                
                local ok, res1, res2 = pcall(function() return UpgradeTower:InvokeServer(tID) end)
                if ok then
                    local msg = string.upper(tostring(res1 or "") .. tostring(res2 or ""))
                    if res1 == true or msg == "TRUE" or string.match(msg, "SUCCESS") then
                        addLog("🌟 MAX-UPGRADED #" .. order, C.Blu)
                        upgradedAny = true
                        task.wait(0.1)
                    elseif string.match(msg, "MAX") or string.match(msg, "LIMIT") then
                        maxedTowers[tID] = true
                    end
                end
            end
            if not upgradedAny then
                task.wait(1) 
            end
        end
    end

    S.replaying = false
    addLog("⏹ REPLAY DONE", C.Cyn)
    if sL then sL.Text = gRunning() and "✅ Done" or "🏁 Game Over" end
end

