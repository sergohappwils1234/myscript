local function mkCycler(parent, values, startIdx, y, onChange)
    local idx = startIdx
    local f = Instance.new("Frame", parent)
    f.Size = UDim2.new(1,-8,0,22); f.Position = UDim2.new(0,4,0,y)
    f.BackgroundColor3 = C.Bg3
