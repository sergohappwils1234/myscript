-- ==================== SMART RECORDING ENGINE ====================
local recData = { actions = {} }
local placeCounter = 0

pcall(function()
    local mt = getrawmetatable(game)
    local oldNamecall = mt.__namecall
    setreadonly(mt, false)

    mt.__namecall = newcclosure(function(self, ...)
        local args = {...}
        local method = getnamecallmethod()
        
        if not checkcaller() and S.recording and method == "InvokeServer" then
            if self.Name == "PlaceTower" and type(args[1]) == "table" then
                local data = args[1]
                local result = {oldNamecall(self, ...)}
                
                if type(result[1]) == "table" then
                    placeCounter = placeCounter + 1
                    local localID = placeCounter
                    
                    local act = {
                        type = "place",
                        placementOrder = localID,
                        towerName = data.towerToPlace,
                        towerID = data.towerID, 
                        x = data.position.X, y = data.position.Y, z = data.position.Z
                    }
                    table.insert(recData.actions, act)
                    addLog("📍 Recorded PLACE: " .. data.towerToPlace, C.Ok)
                    
                    local sID = extractID(result[1])
                    if sID then myPlacedTowers[localID] = sID end
                end
                
                return unpack(result)
                
            elseif self.Name == "UpgradeTower" then
                local result = {oldNamecall(self, ...)}
                
                if result[1] == true then
                    local sID = tostring(args[1])
                    local localID = nil
                    
                    for order, id in pairs(myPlacedTowers) do
                        if id == sID then
                            localID = order
                            break
                        end
                    end
                    
                    if localID then
                        local act = { type = "upgrade", placementOrder = localID }
                        table.insert(recData.actions, act)
                        addLog("⬆ Recorded UPGRADE: #" .. localID, C.Blu)
                    end
                end
                
                return unpack(result)
            end
        end
        return oldNamecall(self, ...)
    end)
    setreadonly(mt, true)
end)

