    lB.Size = UDim2.new(0,24,1,0); lB.Position = UDim2.new(0,0,0,0)
    lB.BackgroundColor3 = C.Sec; lB.Text = "◀"; lB.TextColor3 = C.Tx
    lB.TextSize = 11; lB.Font = Enum.Font.GothamBold
    Instance.new("UICorner",lB).CornerRadius = UDim.new(0,4)
    local rB = Instance.new("TextButton",f)
    rB.Size = UDim2.new(0,24,1,0); rB.Position = UDim2.new(1,-24,0,0)
    rB.BackgroundColor3 = C.Sec; rB.Text = "▶"; rB.TextColor3 = C.Tx
    rB.TextSize = 11; rB.Font = Enum.Font.GothamBold
    Instance.new("UICorner",rB).CornerRadius = UDim.new(0,4)
    local vL = Instance.new("TextLabel",f)
    vL.Size = UDim2.new(1,-52,1,0); vL.Position = UDim2.new(0,26,0,0)
    vL.BackgroundTransparency = 1; vL.TextColor3 = C.Acc
    vL.TextSize = 10; vL.Font = Enum.Font.GothamBold
    vL.Text = tostring(values[idx] or "—")
    local function update()
        vL.Text = tostring(values[idx] or "—")
        onChange(idx, values[idx])
    end
    lB.MouseButton1Click:Connect(function()
        local n = #values; if n == 0 then return end
        idx = idx - 1; if idx < 1 then idx = n end; update()
    end)
    rB.MouseButton1Click:Connect(function()
        local n = #values; if n == 0 then return end
        idx = idx + 1; if idx > n then idx = 1 end; update()
    end)
end

