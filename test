}

local function flushLog()
    if #logBuffer == 0 then return end
    pcall(function()
        local old = isfile(LOG_FILE) and readfile(LOG_FILE) or ""
        writefile(LOG_FILE, old .. table.concat(logBuffer, "\n") .. "\n")
    end)
    logBuffer = {}
end

local function addLog(text, color)
    local line = os.date("%H:%M:%S") .. " " .. text
    table.insert(logEntries, 1, {t = line, c = color or C.Dim})
    if #logEntries > 20 then logEntries[21] = nil end
    table.insert(logBuffer, line)
    logDirty = true
    if #logBuffer >= 5 then flushLog() end
    print("[Macro] " .. text)
end

