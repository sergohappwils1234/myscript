                local e = logEntries[i]; local lb = logLbls[i]
                if e then lb.Text = e.t; lb.TextColor3 = e.c; lb.Visible = true else lb.Visible = false end
            end
            logDirty = false
        end

        flushLog()
        task.wait(0.5)
    end
end)

